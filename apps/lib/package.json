{
  "name": "@leadlovers/simple-email-service",
  "version": "0.1.0",
  "description": "Send transactional emails through LeadLovers infrastructure.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leadlovers/LeadLovers.Lib.SimpleEmailService.git",
    "directory": "apps/lib"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma/schema.prisma",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "build": "prisma generate && rm -rf dist && tsc -p tsconfig.build.json && cp -R src/generated dist/generated",
    "test": "bun test tests/unit",
    "test:int": "bun test tests/integration",
    "prepublishOnly": "bun run build && bun test tests/unit"
  },
  "peerDependencies": {
    "@prisma/adapter-mssql": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "redis": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@prisma/adapter-mssql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/bun": "latest",
    "prisma": "^7.8.0",
    "redis": "^5.12.1",
    "typescript": "^5",
    "zod": "^4.4.3"
  }
}
